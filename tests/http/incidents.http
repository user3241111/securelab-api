@host = http://localhost:5080
@aliceIncidentId = 20000000-0000-0000-0000-000000000001

### Health/readiness
GET {{host}}/health
Accept: application/json

### Working list flow
GET {{host}}/api/incidents
Accept: application/json

### Filtered list
GET {{host}}/api/incidents?status=Triaged
Accept: application/json

### Empty list flow: expected 200 with empty array []
GET {{host}}/api/incidents?status=Resolved
Accept: application/json

### Existing details
GET {{host}}/api/incidents/{{aliceIncidentId}}
Accept: application/json

### Missing resource: expected 404 Problem Details
GET {{host}}/api/incidents/99999999-9999-9999-9999-999999999999
Accept: application/json

### Invalid filter: expected 400 Validation Problem Details
GET {{host}}/api/incidents?status=Unknown
Accept: application/json

### Lab 1 extension point: expected 200 OK with severity summary

# Підсумок інцидентів за severity (Етап 3, варіант 2-A)
# Метод: GET /api/incidents/severity-summary
# Очікувана відповідь: 200 OK, Content-Type: application/json
# Тіло: JSON-масив об'єктів { severity: string, count: int }
# Політика нульових груп: лише наявні групи (baseline повертає Low, Medium, High)
# Сортування: count descending, severity ascending
# Заборонені дані: description, owner ID, email, comments

GET {{host}}/api/incidents/severity-summary
Accept: application/json